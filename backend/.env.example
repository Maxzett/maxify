# Copiá este archivo como .env y completá los valores.
# Conexión a MongoDB (Atlas en producción, local en desarrollo).
MONGODB_URI=mongodb://localhost:27017/maxify
PORT=3000
# Orígenes permitidos por CORS, separados por coma.
FRONTEND_ORIGIN=http://localhost:4200
# Secreto para firmar los JWT (una cadena larga y aleatoria).
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Credenciales de Cloudinary (Dashboard → API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
